# --- Web (FastAPI) ---
PORT=8080
SESSION_SECRET=generate-a-random-secret-here

# --- Database ---
# Production (PostgreSQL via docker-compose service):
DATABASE_URL=postgresql://opsdash:opsdash@db:5432/opsdash

# Dev (SQLite, in container):
# DATABASE_URL=sqlite:///./data/opsdash.db

# --- Optional: Teams webhooks (for daily digest, leader alerts, retention alerts) ---
# TEAMS_DIGEST_WEBHOOK=https://outlook.office.com/webhook/...
# TEAMS_ALERT_WEBHOOK=https://outlook.office.com/webhook/...

# --- Optional: AI-assisted review ---
# AI only proposes changes; a lead must approve them in the web review queue.
AI_REVIEW_ENABLED=false
AI_REVIEW_MODEL=gpt-5.5
# OPENAI_API_KEY=sk-...
